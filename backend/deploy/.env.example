# Server settings for deploy/compose.yaml. Copy to /var/www/html/iso-agent/.env and fill in.
# Any backend setting from backend/.env.example can be added here (QDRANT_URL is set by compose).

GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Optional. The frontend is served from the same domain (Nginx proxies /api), so no CORS is
# needed; list origins here only for other sites that call the API directly.
# CORS_ORIGINS=https://other-site.example.com

# Host port for the API on 127.0.0.1 (point the reverse proxy here).
# BACKEND_PORT=8000

# The deploy job sets BACKEND_TAG to the commit SHA it deploys. Set it here only to pin
# a version when starting the stack by hand (e.g. a rollback).
# BACKEND_TAG=latest
