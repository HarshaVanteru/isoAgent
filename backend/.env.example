# Backend settings. Relative paths (DOCUMENT_DIR, DATA_DIR, MODEL_CACHE_DIR, QDRANT_PATH) resolve from backend/.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
EMBEDDING_MODEL=BAAI/bge-m3
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
MODEL_DEVICE=cpu
MODEL_CACHE_DIR=.cache/huggingface/hub
MODEL_LOCAL_FILES_ONLY=false
CHUNK_MAX_TOKENS=500
VECTOR_SEARCH_LIMIT=20
FINAL_RESULT_LIMIT=5
MULTI_QUERY_LIMIT=3
MULTI_QUERY_CANDIDATE_LIMIT=40
RETRIEVAL_MAX_RETRIES=1
CLARIFICATION_MAX_ROUNDS=2
# Answers respond automatically; unclear questions ask for clarification.
# GPT-OSS supports native JSON schema decisions. Other models may need json_mode.
GRAPH_STRUCTURED_OUTPUT_METHOD=json_schema
EMBEDDING_BATCH_SIZE=16
RERANKER_BATCH_SIZE=8
RERANKER_MAX_TOKENS=1024
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=iso_documents_bge_m3
# Set to data/qdrant-local for embedded Qdrant instead of Docker (one process).
QDRANT_PATH=
QDRANT_API_KEY=
QDRANT_BATCH_SIZE=64
UPLOAD_MAX_BYTES=52428800
LIBREOFFICE_PATH=
DOCUMENT_DIR=ISO 9001 Full Documents
DATA_DIR=data
# Optional full path if LibreOffice is not on PATH. Needed for legacy files without MS Office.
SOFFICE_PATH=
# Comma-separated browser origins allowed to call the API directly (match VITE_DEV_PORT in frontend/.env).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional native LangGraph tracing (one parent trace per request, with nested steps).
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=iso-agent
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_WORKSPACE_ID=
